; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Alpha Crush"
config/description="Crush the opposition: a stylised third-person action shooter that fuses gun play and kung-fu on one thumb."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0392157, 0.0705882, 0.188235, 1)
boot_splash/image="res://assets/branding/boot_splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
config/icon="res://icon.png"
config/version="3.0.0"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/default_font_multichannel_signed_distance_field=true

[physics]

3d/default_gravity=9.8

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=1
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="alpha"
3d_physics/layer_3="opposition"
3d_physics/layer_4="breakable"
3d_physics/layer_5="pickup"
